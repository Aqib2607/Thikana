# Thikana Frontend Environment Configuration

# Base URL for Thikana Backend API.
# In same-origin gateway deployment (Laravel serving frontend), default is "/api/v1".
# For split-origin local development (e.g. Vite on 8080), use "http://localhost:8000/api/v1".
VITE_API_BASE_URL=/api/v1

# Mock data toggle: set to false for production and real backend integration
# Set to true only for local offline UI development or demo environments
VITE_USE_MOCK=false


